pipeline {
    agent any

    stages {
 
        stage('Clone Code') {
            steps {
                git 'https://github.com/lakshmisailaja-cloud/3-tier-app.git'  
            }
        }

        stage('Build') {
            steps {
                echo 'Building Application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Application'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker rm -f myapp || true'
                sh 'docker run -d -p 80:80 --name myapp nginx'
            }
        }
    }
}
